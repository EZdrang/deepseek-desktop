{
  "name": "deepseek-web-desktop",
  "version": "1.2.0",
  "description": "Personal Electron desktop wrapper for the official DeepSeek website",
  "main": "main.js",
  "author": "doxdk (dk) and contributors; Windows fork maintained by EZdrang",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.cjs",
    "build:dir": "node scripts/build.cjs --dir",
    "setup": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.deepseek.webdesktop",
    "productName": "DeepSeek Web Desktop",
    "copyright": "Based on MIT licensed code Copyright (c) 2025 dk",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "navigation.cjs",
      "deepseek-logo.png",
      "LICENSE",
      "NOTICE.md"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "deepseek-logo.png",
      "executableName": "DeepSeek-Web-Desktop"
    },
    "nsis": {
      "artifactName": "DeepSeek-Desktop-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek 网页桌面版",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "language": "2052",
      "include": "build/installer.nsh"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "repository": {
    "url": "git+https://github.com/EZdrang/deepseek-desktop.git",
    "type": "git"
  },
  "homepage": "https://github.com/EZdrang/deepseek-desktop#readme",
  "bugs": {
    "url": "https://github.com/EZdrang/deepseek-desktop/issues"
  }
}
